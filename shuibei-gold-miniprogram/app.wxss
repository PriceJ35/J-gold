/* app.wxss - 全局样式 */
page {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  min-height: 100vh;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 主题色变量 */
.theme-gold {
  color: #ffd700;
}

.theme-bg {
  background-color: #1a1a2e;
}

/* 卡片样式 */
.card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1px solid rgba(255, 215, 0, 0.2);
  margin-bottom: 20rpx;
}

/* 通用flex布局 */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 文字样式 */
.text-gold {
  color: #ffd700;
}

.text-gray {
  color: #888888;
}

.text-sm {
  font-size: 24rpx;
}

.text-md {
  font-size: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: bold;
}
